require('dotenv').config();
const express = require('express');
const cors = require('cors');
const nodemailer = require('nodemailer');
const sqlite3 = require('sqlite3').verbose();
const { v4: uuidv4 } = require('uuid');

const app = express();
app.use(cors());
app.use(express.json());

const db = new sqlite3.Database('./requests.db', sqlite3.OPEN_READWRITE | sqlite3.OPEN_CREATE, (err) => {
    if (err) {
        console.error('Database connection failed:', err.message);
        process.exit(1);
    }
    console.log('Connected to SQLite database.');
});

db.run(`CREATE TABLE IF NOT EXISTS requests (
    id TEXT PRIMARY KEY,
    name TEXT,
    vat TEXT,
    provider TEXT,
    request_date TEXT,
    email TEXT,
    seller TEXT,
    comments TEXT
)`);

const transporter = nodemailer.createTransport({
    service: 'gmail',
    auth: {
        user: process.env.EMAIL_USER,
        pass: process.env.EMAIL_PASS
    }
});

const sanitizeInput = (input) => input.replace(/[^a-zA-Z0-9 @.,-]/g, ''); // Αποφυγή SQL Injection

app.post('/submit', (req, res) => {
    try {
        const { name, vat, provider, email, seller, comments } = req.body;

        if (!name || !vat || !provider || !email) {
            return res.status(400).json({ error: "Όλα τα πεδία είναι υποχρεωτικά!" });
        }

        const id = uuidv4();
        const request_date = new Date().toISOString();

        db.run(`INSERT INTO requests (id, name, vat, provider, request_date, email, seller, comments) 
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
            [id, sanitizeInput(name), sanitizeInput(vat), sanitizeInput(provider), request_date, sanitizeInput(email), sanitizeInput(seller), sanitizeInput(comments)],
            (err) => {
                if (err) return res.status(500).json({ error: "Σφάλμα στη βάση δεδομένων!" });

                const mailOptions = {
                    from: process.env.EMAIL_USER,
                    to: 'revma@encomsol.com',
                    subject: 'Νέα Αίτηση Ρεύματος',
                    text: `Αίτηση από ${name} (ΑΦΜ: ${vat}) προς ${provider}. Πωλητής: ${seller}. Σχόλια: ${comments}`
                };

                transporter.sendMail(mailOptions, (error) => {
                    if (error) return res.status(500).json({ error: "Αποτυχία αποστολής email!" });
                    res.status(200).json({ message: 'Αίτηση καταχωρήθηκε επιτυχώς!' });
                });
            }
        );
    } catch (err) {
        console.error('Server error:', err);
        res.status(500).json({ error: "Κάτι πήγε στραβά!" });
    }
});

const PORT = process.env.PORT || 5000;
app.listen(PORT, () => console.log(`Server running on port ${PORT}`));
